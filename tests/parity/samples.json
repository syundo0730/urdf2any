{
  "_comment": "Canonical conversion flags for the parity corpus. Read by both tests/test_golden_parity.py (urdf2any side) and scripts/generate_reference.py (IsaacLab side) so the two stay in lockstep. urdf paths are relative to the repo root. Each entry is one golden file tests/golden/<name>.json. The *_merged entries use merge_fixed_joints=true (IsaacLab's default and what ConvertConfig.isaaclab() reproduces); the plain entries use merge_fixed_joints=false (urdf2any's default, reference must override IsaacLab's default to match).",
  "samples": {
    "simple_2_link": {
      "urdf": "tests/assets/simple_2_link/simple_2_link.urdf",
      "fix_base": false,
      "merge_fixed_joints": false,
      "joint_target_type": "position",
      "joint_stiffness": 100.0,
      "joint_damping": 1.0,
      "skip_collision_inertia": false,
      "collider_type": "convex_hull"
    },
    "franka": {
      "urdf": "tests/assets/franka/robot.urdf",
      "fix_base": true,
      "merge_fixed_joints": false,
      "joint_target_type": "position",
      "joint_stiffness": 100.0,
      "joint_damping": 1.0,
      "skip_collision_inertia": false,
      "collider_type": "convex_hull"
    },
    "simple_2_link_merged": {
      "urdf": "tests/assets/simple_2_link/simple_2_link.urdf",
      "fix_base": false,
      "merge_fixed_joints": true,
      "joint_target_type": "position",
      "joint_stiffness": 100.0,
      "joint_damping": 1.0,
      "skip_collision_inertia": false,
      "collider_type": "convex_hull"
    },
    "franka_merged": {
      "urdf": "tests/assets/franka/robot.urdf",
      "fix_base": true,
      "merge_fixed_joints": true,
      "joint_target_type": "position",
      "joint_stiffness": 100.0,
      "joint_damping": 1.0,
      "skip_collision_inertia": false,
      "collider_type": "convex_hull"
    }
  }
}
